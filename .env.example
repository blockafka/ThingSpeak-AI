# ============ LLM (OpenAI 兼容协议 / SiliconFlow) ============
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your_siliconflow_api_key_here
# Qwen3 系列默认开启 thinking 模式，耗时长且占用输出 token，设为 1 关闭
LLM_DISABLE_THINKING=1
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ============ 文生图（v1 预留接口，mock 模式即可） ============
IMAGE_GEN_PROVIDER=mock
IMAGE_GEN_MODEL=
IMAGE_GEN_API_KEY=

# ============ 服务 ============
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=info
