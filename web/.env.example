# 前端环境变量（Vite 仅暴露 VITE_ 前缀变量）

# 方式 A：直连后端（后端需开启 CORS，本项目 FastAPI 已允许 *）
# 部署时在 Vercel / Netlify 构建环境变量中设置，例如：
# VITE_API_BASE_URL=https://your-backend.railway.app
VITE_API_BASE_URL=

# 方式 B：同域 API 反代（构建时设置 BACKEND_URL，由 prebuild 生成 vercel.json / netlify.toml）
# BACKEND_URL=https://your-backend.railway.app
# 此时 VITE_API_BASE_URL 留空，前端走 /api/* 相对路径
